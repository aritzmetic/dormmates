rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function mem(s) { return request.auth.uid in get(/databases/$(d)/documents/spaces/$(s)).data.members; }
    function own(s) { return get(/databases/$(d)/documents/spaces/$(s)).data.ownerId == request.auth.uid; }
    match /spaces/{s} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (request.resource.data.ownerId == resource.data.ownerId || resource.data.ownerId == request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /punches/{p} {
        allow read: if mem(s);
        allow create: if mem(s) && request.resource.data.uid == request.auth.uid;
        allow delete: if own(s);
      }
      match /exceptions/{e} {
        allow read: if mem(s);
        allow create: if mem(s) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
        allow update, delete: if own(s);
      }
      match /notes/{n} {
        allow read: if mem(s);
        allow create: if mem(s) && request.resource.data.uid == request.auth.uid;
        allow delete: if own(s) || resource.data.uid == request.auth.uid;
      }
      match /bills/{b} {
        allow read: if mem(s);
        allow write: if own(s);
      }
    }
  }
}
